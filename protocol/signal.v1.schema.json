{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://follenfang.github.io/lycheedev/protocol/signal.v1.schema.json",
  "title": "lycheedev.signal.v1",
  "description": "Optical game-to-host receipt. It is identity/status only and never carries a report body. Kind identity is a session-free identity marker correlated by probeNonce; it binds no session and grants no input authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "sequence", "inputReady"],
  "properties": {
    "schema": { "const": "lycheedev.signal.v1" },
    "release": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["ready", "loaded", "reported", "acknowledged", "cancelled", "cleared", "identity", "reset"] },
    "sessionNonce": { "type": "string", "maxLength": 64 },
    "requestId": { "type": "string", "maxLength": 128 },
    "reloadNonce": { "type": "string", "maxLength": 64 },
    "cleanupNonce": { "type": "string", "maxLength": 64 },
    "probeNonce": { "type": "string", "maxLength": 64 },
    "actorState": { "type": "string", "maxLength": 32 },
    "inputReason": { "type": "string", "maxLength": 64 },
    "character": { "type": "string", "maxLength": 128 },
    "realm": { "type": "string", "maxLength": 128 },
    "guid": { "type": "string", "maxLength": 128 },
    "product": { "type": "string", "minLength": 1, "maxLength": 64 },
    "build": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "runtimeEpoch": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "inputReady": { "type": "boolean" },
    "codeBytes": { "type": "integer", "minimum": 0, "maximum": 262144 },
    "codeAdler32": { "type": "string", "maxLength": 8 },
    "reportBytes": { "type": "integer", "minimum": 0, "maximum": 524288 },
    "reportAdler32": { "type": "string", "maxLength": 8 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "identity" } }, "required": ["kind"] },
      "then": {
        "required": ["probeNonce", "actorState"],
        "properties": {
          "probeNonce": { "pattern": "^[0-9a-f]{32}$" },
          "actorState": { "enum": ["ok", "no_actor", "actor_restricted"] },
          "sessionNonce": { "const": "" },
          "requestId": { "const": "" },
          "reloadNonce": { "const": "" },
          "cleanupNonce": { "const": "" },
          "sequence": { "const": 0 },
          "codeBytes": { "const": 0 },
          "codeAdler32": { "const": "" },
          "reportBytes": { "const": 0 },
          "reportAdler32": { "const": "" },
          "inputReason": { "pattern": "^$|^input_[a-z0-9_]+$" }
        },
        "allOf": [
          {
            "if": { "properties": { "actorState": { "const": "ok" } } },
            "then": {
              "required": ["character", "realm"],
              "properties": { "character": { "minLength": 1 }, "realm": { "minLength": 1 } }
            },
            "else": {
              "properties": {
                "character": { "maxLength": 0 },
                "realm": { "maxLength": 0 },
                "guid": { "maxLength": 0 }
              }
            }
          }
        ]
      }
    },
    {
      "if": { "properties": { "kind": { "enum": ["ready", "loaded", "reported", "acknowledged", "cancelled", "cleared"] } }, "required": ["kind"] },
      "then": {
        "required": ["release", "product", "build"],
        "properties": {
          "release": { "minLength": 1 },
          "product": { "minLength": 1 },
          "build": { "minLength": 1 },
          "sequence": { "minimum": 1 },
          "probeNonce": { "maxLength": 0 },
          "actorState": { "maxLength": 0 },
          "inputReason": { "maxLength": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "ready" } }, "required": ["kind"] },
      "then": { "required": ["sessionNonce"], "properties": { "sessionNonce": { "minLength": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "enum": ["loaded", "reported", "acknowledged", "cancelled", "cleared"] } }, "required": ["kind"] },
      "then": { "required": ["requestId"], "properties": { "requestId": { "minLength": 1 } } }
    },
    {
      "if": { "properties": { "kind": { "const": "reset" } }, "required": ["kind"] },
      "then": {
        "required": ["probeNonce", "character", "realm", "guid"],
        "properties": {
          "probeNonce": { "pattern": "^[0-9a-f]{32}$" },
          "character": { "minLength": 1 }, "realm": { "minLength": 1 }, "guid": { "minLength": 1 },
          "sequence": { "const": 0 }, "inputReady": { "const": false },
          "sessionNonce": { "const": "" }, "requestId": { "const": "" },
          "reloadNonce": { "const": "" }, "cleanupNonce": { "const": "" },
          "actorState": { "const": "" }, "inputReason": { "const": "" },
          "codeBytes": { "const": 0 }, "reportBytes": { "const": 0 },
          "codeAdler32": { "const": "" }, "reportAdler32": { "const": "" }
        }
      }
    }
  ]
}
