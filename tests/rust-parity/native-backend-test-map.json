  "groups": [
    {
      "id": "publication_and_receipt_boundary",
      "rustTests": [
        "native_invoke_holds_exact_publication_through_burst_and_consumes_no_claim",
        "native_reload_checks_pool_and_closes_before_sender",
        "native_publication_route_and_reload_close_failures_never_send",
        "native_publish_rechecks_guard_under_lock_and_joins_checked_close"
      ],
      "goTestFiles": [
        "internal/live/channel/publication_windows_test.go",
        "internal/live/channel/publication_blocker_windows_test.go"
      ],
      "assertionScope": "Same typed PublicationLease covers verify+route+Invoke; Reload inspect is checked-closed before sender. All successfully acquired leases explicitly close and join errors. Native does not mark consumption from an INPUT or queue receipt; Driver.transactions qualifies and durably records exact runtime receipt before calling consumed. Test publication is an injected lease model; real filesystem/Windows behavior remains NOT_RUN.",
      "status": "implemented_unverified; NOT_RUN"
    },
    {
      "id": "ephemeral_witness_cadence_and_no_replay",
      "rustTests": [
        "native_persisted_input_dto_has_no_witness_and_cannot_send",
        "native_input_witness_is_one_use_even_after_zero_or_partial_send",
        "native_changed_current_publication_or_binding_blocks_before_messages",
        "native_stale_grace_does_not_move_for_newer_expired_samples",
        "native_missing_changed_and_blocked_input_do_not_forge_execution",
        "native_driver_recovery_watermark_can_tighten_same_witness_at_exact_future_boundary"
      ],
      "goTestFiles": [
        "internal/live/channel/input_cadence_windows_test.go",
        "internal/live/channel/input_stale_test.go",
        "internal/live/channel/input_bindings_test.go",
        "internal/live/channel/input_cadence_test.go",
        "internal/live/channel/input_journal_test.go"
      ],
      "assertionScope": "Witness is private, non-serializable, one-use and bound to this backend observation. Final fresh named INPUT rechecks exact transient address/sample/bindings and original after+100/now-500/now+100. Driver may tighten the recovered watermark; witness accepts only nondecreasing after and final decoder enforces it. Within 2s stale grace retain stale marker; after grace plain pending permits normal discovery. Unknown replay prevention remains the existing durable Driver boundary; adapter never loops or retries a chord.",
      "status": "implemented_unverified; NOT_RUN"
    },
    {
      "id": "input_errors_and_original_control",
      "rustTests": [
        "native_input_refresh_lookup_preserves_path_and_cancellation_causes",
        "native_partial_input_and_publication_close_errors_are_joined",
        "native_original_cancellation_prevents_input_and_never_extends_deadline",
        "native_expired_control_after_fresh_read_cannot_send_or_consume",
        "native_guard_failure_during_cancellation_retains_both_causes",
        "native_cancel_between_admission_and_first_post_is_still_known_zero"
      ],
      "goTestFiles": [
        "internal/live/channel/input_cadence_windows_test.go",
        "internal/live/channel/publication_windows_test.go",
        "internal/live/channel/native_diagnostics_windows_test.go"
      ],
      "assertionScope": "Ordered MailboxControl child retains original control ancestry/deadline. Guard/read/post/cleanup failures keep queue counts and all independent typed causes; partial is uncertain, retryable only known-zero. FakeSender models admission then per-message guards; scripted receipt failures are model facts, not actual PostMessage evidence.",
      "status": "implemented_unverified; NOT_RUN"
    },
    {
      "id": "capability_and_diagnostics",
      "rustTests": [
        "native_retired_actions_and_capabilities_do_not_acquire_or_send",
        "native_previous_two_key_schema_allows_only_fresh_reload",
        "native_open_legacy_identity_remains_explicit_manual_activation",
        "native_receipt_diagnostic_probe_once_per_exchange_is_not_receipt_or_input_authority",
        "native_candidate_is_untrusted_and_requires_fixed_actor_and_newer_token"
      ],
      "goTestFiles": [
