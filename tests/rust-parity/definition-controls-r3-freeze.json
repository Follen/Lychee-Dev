  "scope": [
    "Original invocation control and independent Budget throughout definition read/wait/HTTP/parse/publish",
    "Minimum prefix consumer admission seam in existing raw/gzip collectors; default no-op routes preserved",
    "Go 30-second per-request cap, no redirects, default gzip, 4 MiB + 1 LimitReader prefix, 8 MiB logical scratch, actual 4x logical bytes and prior 8x safety accounting",
    "Exact Go cached-object scalar/null/merge/casefold decoding via existing wire types; cache corruption remains terminal",
    "Manifest caller reparse removed, DBD line/field/hash checks, semantic row checks, explicit Metadata close with distinct typed causes"
  ],
  "remainingGaps": [
    "Core publish_internal_with_check and publish_blob_reader_internal hidden root Directory uses unchecked Drop; not changed or claimed closed here",
    "Existing gzip decode-versus-budget/cancellation error precedence gap is unchanged; this is not the denied gzip candidate or a retest of it",
    "Core <=1 MiB raw JSON and <=4 MiB Manifest serde passes have checks at bounded pass/entry boundaries, not instruction-level preemption",
    "No runtime compilation or tests; shared runner channels have active owner leases and were not touched",
    "SQL/DB2 external production call-site adoption belongs to separate Data owner; APIs are now available"
  ],
  "consumerInterfaces": [
