    "creature": "Existing baseline from creature_navigation_parity::tables(), unchanged.",
    "firstModelNoDisplays": "Baseline without the ModelID=2 display rows (10 and 30); retain model rows 2 and 3 for file 500 and display 20 for model 3.",
    "modelFileZero": "Baseline with CreatureModelData row 2 FileDataID=0; direct display 10 stays complete and emits no model_file relation.",
    "scalarTextures": "Baseline with TextureVariationFileDataID a scalar uint field (800 on display 10); every projection is [].",
    "signedTextures": "Baseline with TextureVariationFileDataID int32[2]; display 10 is [-1,800], other rows [0,0].",
    "floatTextures": "Baseline with TextureVariationFileDataID float32[2]; display 10 is [800.75,900.5], other rows [0,0]; all texture projections are [].",
    "missingPresentation": "Baseline without TextureVariationFileDataID and without both GeosetIndex/GeosetValue columns; display 10 has variations [100,100].",
    "signedGeosets": "Baseline except Geoset rows are ID1/display10/index-1/value0, ID2/display10/index-2/value-3, ID3/display10/index0/value-7.",
    "floatGeosets": "Baseline except GeosetIndex and GeosetValue are float32 and the only Geoset row is ID1/display10/index-2.75/value-3.75.",
    "wideGeosets": "Authenticated signed 64-bit GeosetIndex/GeosetValue: rows ID1..4 for display10 hold [i64MAX,0],[i64MAX-1,0],[i64MIN,0],[0,i64MAX], yielding [0,-100,100,-9223372036854775709]. Must not fake this with 32-bit fields.",
    "missingDisplay": "Baseline with CreatureDisplayInfo omitted.",
    "missingModel": "Baseline with CreatureModelData omitted.",
    "missingGeoset": "Baseline with CreatureDisplayInfoGeosetData omitted.",
    "firstInvalidThenMissing": "Baseline CreatureDisplayInfo WDC truncated by one final byte, with CreatureModelData omitted; first-table failure must win before missing second-table resolution.",
    "invalidNonmatchingDisplay": "Baseline display table gains unused text column and ID999/ModelID99/nonmatching row with BadString; all original rows use valid empty text.",
    "invalidNonmatchingModel": "Baseline model table gains unused text column and ID99/FileDataID999/nonmatching row with BadString; original rows have valid empty text.",
    "invalidNonmatchingGeoset": "Baseline geoset table gains unused text column and ID999/CreatureDisplayInfoID999/nonmatching row with BadString; original rows have valid empty text.",
    "modelFileMissing": "Baseline without CreatureModelData.FileDataID; direct display10 projects file0, scanning file500 is field_unknown.",
    "modelFileFloat": "Baseline CreatureModelData.FileDataID is float32; row2=500.75,row3=500.5,row4=600.0. Direct display10 projects500; file-key/model scans reject field type.",
    "displayModelMissing": "Baseline without CreatureDisplayInfo.ModelID; direct display10 is unresolved/model0; file-key/model scans reject absent field.",
    "displayModelFloat": "Baseline CreatureDisplayInfo.ModelID is float32; display10=2.75, display30=2.5, others use original integral values. Direct display10 resolves model2; file-key/model scans reject field type.",
    "geosetDisplayMissing": "Baseline without CreatureDisplayInfoGeosetData.CreatureDisplayInfoID; any reached variation scan rejects absent field.",
    "geosetDisplayFloat": "Baseline CreatureDisplayInfoGeosetData.CreatureDisplayInfoID is float32 holding original values; any reached variation scan rejects field type.",
    "geosetExact": "Baseline display10/model2/file500, only Geoset rows ID1..65536 matching display10, index0,value=rowID.",
    "geosetRowBound": "Same as geosetExact with rows ID1..65537; retain first65536, row_budget.",
    "relationExact": "Only display rows ID1..65535 with ModelID2 and zero texture array; only model2/file500; empty Geoset table. File lookup emits65535 display links then one model_file link, without truncation.",
    "relationBound": "Same as relationExact with65536 displays; model_file link exceeds relation cap; retain all65536 display links and relation_budget.",
    "displayRowBound": "Same as relationExact with65537 displays; retain65536 display links and row_budget as first reason.",
    "modelExact": "Only models ID1..65536 all FileDataID500; only display10/ModelID1/zero texture array; empty Geoset table. Multiple models are ambiguous, no row truncation.",
