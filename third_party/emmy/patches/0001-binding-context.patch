+//! Immutable host-selected binding evidence for one semantic query session.
+//! This is a new public-base reconstruction, not the historical private patch.
+#![forbid(unsafe_code)]
+
+use crate::{FileId, SemanticId};
+use emmylua_parser::LuaSyntaxId;
+use rowan::TextRange;
+use serde::{Deserialize, Serialize};
