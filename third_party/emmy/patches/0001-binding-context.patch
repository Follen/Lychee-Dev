+            BindingDecision::NotManaged => true,
+            BindingDecision::Bound(permit) => {
+                let actual = self
+                    .syntax_tree()
+                    .and_then(|t| syntax.to_node_from_root(&t.get_red_root()))
+                    .and_then(LuaCallExpr::cast)
+                    .and_then(|c| c.get_prefix_expr())
