+#[derive(Clone, Debug)]
+pub enum BindingDecision<T> {
+    NotManaged,
+    Bound(T),
+    KnownAbsent { proof: String },
+    Unavailable { proof: String, reason: String },
+}
+#[derive(Clone, Debug)]
+pub struct BoundValue { pub identity: String, pub proof: String, pub value: SelectedValue }
+#[derive(Clone, Debug)]
+pub enum SelectedValue {
+    Expression(BindingSite), Parameter(SemanticId), Function(FunctionRef), Object(ObjectRef),
+    DerivedNumber(DerivedNumber), EnvironmentCallable(Arc<EnvironmentCallable>),
+    EnvironmentReturn(EnvironmentReturn),
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FunctionRef { pub file_id: FileId, pub closure: LuaSyntaxId, pub declaration: Option<SemanticId> }
+#[derive(Clone, Debug)]
+pub struct SourceSpan { pub file_id: FileId, pub range: TextRange }
+#[derive(Clone, Debug)]
+pub struct ExternalSourceSpan { pub path: String, pub content_sha256: String, pub range: TextRange }
+#[derive(Clone, Debug)]
+pub enum ObjectOrigin { Lua(BindingSite), Xml(ExternalSourceSpan) }
+#[derive(Clone, Debug)]
+pub enum FieldWriteOrigin { Lua(SourceSpan), Xml(ExternalSourceSpan) }
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct ObjectViewKey { pub context: String, pub observation: usize, pub object_id: usize }
+#[derive(Clone, Debug)]
+pub struct ObjectRef { pub identity: String, pub epoch: String, pub origin: ObjectOrigin, pub view: ObjectViewKey }
+#[derive(Clone, Debug)]
+pub struct ObjectShape { pub key: ObjectViewKey, pub fields: Vec<ObjectField>, pub enumeration: ShapeEnumeration, pub proof: String }
+#[derive(Clone, Debug)]
+pub struct ObjectField { pub key: String, pub presence: FieldPresence, pub value: BindingDecision<BoundValue>, pub destination_write: FieldWriteOrigin, pub source_write: Option<FieldWriteOrigin>, pub copy_origin: Option<FieldWriteOrigin> }
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum FieldPresence { Present, Absent, Unavailable }
+#[derive(Clone, Debug)]
+pub enum ShapeEnumeration { Complete, Unavailable(String) }
+#[derive(Clone, Debug)]
+pub struct DerivedNumber { pub value: f64, pub origin: SourceSpan, pub occurrence_identity: String, pub rule: DerivedNumberRule, pub proof: String }
+#[derive(Clone, Debug)]
+pub enum DerivedNumberRule { NumericForIteration { statement: BindingSite, header: Vec<BindingSite>, iteration: usize, predecessor: Option<String> } }
+#[derive(Clone, Debug)]
+pub struct CallPermit { pub callee: BindingSite, pub proof: String, pub capability_profile: String }
+#[derive(Clone, Debug)]
+pub enum ObservedCallee { Source(FunctionRef), Environment(Arc<EnvironmentCallable>) }
+#[derive(Clone, Debug)]
+pub struct CallObservation { pub callee: ObservedCallee, pub selected_callee_identity: String, pub closure_identity: String, pub invocation_identity: String, pub returns: Vec<BindingDecision<BoundValue>>, pub proof: String }
+#[derive(Clone, Debug)]
