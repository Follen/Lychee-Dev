+    fn binding_value_type(&self, site: BindingSite, value: &SelectedValue) -> Result<LuaType, &'static str> {
+        match value {
+            SelectedValue::Expression(origin) => {
+                let model = self.model_for(origin.file_id);
+                let node = model.syntax_tree().and_then(|t| origin.syntax.to_node_from_root(&t.get_red_root())).and_then(LuaExpr::cast).ok_or("selected_expression_missing")?;
+                Ok(model.type_of_expr(node.get_syntax_id()))
+            }
+            SelectedValue::Parameter(parameter) => {
+                let file = match parameter { SemanticId::Decl(key) => key.file_id, _ => return Err("selected_parameter_not_declaration") };
+                let model = self.model_for(file);
+                let decl = model.file_facts().and_then(|f| f.decl_by_id(parameter)).ok_or("selected_parameter_missing")?;
+                if !matches!(decl.kind, crate::DeclKind::Param) { return Err("selected_parameter_not_parameter"); }
+                model.type_of_decl(parameter).ok_or("selected_parameter_type_unavailable")
+            }
+            SelectedValue::Function(function) => self.type_of_signature_in_file(function.file_id, function.closure).map(|f| LuaType::DocFunction(Arc::new(f))).ok_or("selected_function_signature_unavailable"),
+            SelectedValue::DerivedNumber(number) => {
+                if !number.value.is_finite() || number.occurrence_identity.is_empty() || number.proof.is_empty() { return Err("derived_number_evidence_invalid"); }
+                match &number.rule { DerivedNumberRule::NumericForIteration { statement, header, iteration, predecessor } => {
+                    let model = self.model_for(statement.file_id);
+                    let statement_valid = model.syntax_tree().and_then(|t| statement.syntax.to_node_from_root(&t.get_red_root())).and_then(emmylua_parser::LuaForStat::cast).is_some();
+                    if !statement_valid || !(2..=3).contains(&header.len()) || (*iteration == 0) != predecessor.is_none() { return Err("derived_number_rule_invalid"); }
+                }}
+                Ok(LuaType::FloatConst(number.value))
+            }
+            SelectedValue::Object(object) => self.binding_object_type(site, object),
+            SelectedValue::EnvironmentCallable(callable) => environment_function(callable).map(|f| LuaType::DocFunction(Arc::new(f))),
+            SelectedValue::EnvironmentReturn(result) => {
+                if result.invocation_identity.is_empty() || result.slot == 0 { return Err("environment_return_identity_invalid"); }
+                let slot = result.callable.declaration.returns.get(result.slot - 1).ok_or("environment_return_slot_unavailable")?;
+                environment_slot(slot, &result.callable.types, 0)
+            }
+        }
+    }
+}
