+    pub(crate) fn binding_manages(&self, syntax: LuaSyntaxId) -> bool {
+        self.binding_session.as_ref().is_some_and(|session| {
+            !matches!(
+                session.context.resolve(BindingSite {
+                    file_id: self.file_id(),
+                    syntax
+                }),
+                BindingDecision::NotManaged
+            )
+        })
+    }
