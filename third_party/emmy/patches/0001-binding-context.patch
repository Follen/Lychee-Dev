+use super::*;
+use crate::{EmmyLuaAnalysis, LuaType};
+use emmylua_parser::{LuaAstNode, LuaExpr};
+use std::collections::HashMap;
+
+struct Context {
+    identity: String,
+    decisions: HashMap<BindingSite, BindingDecision<BoundValue>>,
+    calls: HashMap<BindingSite, BindingDecision<CallPermit>>,
+    observations: HashMap<BindingSite, CallObservation>,
+}
+impl BindingContext for Context {
+    fn identity(&self) -> &str { &self.identity }
+    fn resolve(&self, site: BindingSite) -> BindingDecision<BoundValue> { self.decisions.get(&site).cloned().unwrap_or(BindingDecision::NotManaged) }
+    fn call(&self, site: BindingSite) -> BindingDecision<CallPermit> { self.calls.get(&site).cloned().unwrap_or(BindingDecision::NotManaged) }
+    fn call_observation(&self, site: BindingSite) -> BindingDecision<CallObservation> { self.observations.get(&site).cloned().map(BindingDecision::Bound).unwrap_or(BindingDecision::NotManaged) }
+}
+fn context(identity: &str) -> Context { Context { identity: identity.into(), decisions: HashMap::new(), calls: HashMap::new(), observations: HashMap::new() } }
+fn site(analysis: &EmmyLuaAnalysis, file_id: FileId, text: &str) -> BindingSite {
+    let model = analysis.semantic_model(file_id);
+    let expr = model.syntax_tree().unwrap().get_red_root().descendants().filter_map(LuaExpr::cast).find(|expr| expr.syntax().text().to_string() == text).unwrap();
+    BindingSite { file_id, syntax: expr.get_syntax_id() }
+}
+fn load() -> (EmmyLuaAnalysis, Vec<FileId>, Arc<str>) {
+    let mut analysis = EmmyLuaAnalysis::new();
+    let root = std::env::current_dir().unwrap().join("binding-test-input");
+    analysis.add_main_workspace(root.clone());
+    let text: Arc<str> = Arc::from("local x = 42\nreturn x, x + 1\n");
+    let ids = analysis.update_files_by_path_shared_checked(vec![(root.join("a.lua"), Some(text.clone())), (root.join("b.lua"), Some(Arc::from("return true\n")))], || Ok::<_, ()>(())).unwrap();
+    (analysis, ids, text)
+}
+#[test]
+fn shared_ingestion_preserves_allocation_and_facts() {
+    let (analysis, ids, text) = load();
+    assert_eq!(analysis.db.get_file_text(ids[0]).unwrap().as_ptr(), text.as_ptr());
+    let mut other = EmmyLuaAnalysis::new();
+    let path = std::env::current_dir().unwrap().join("binding-test-input/a.lua");
+    let other_ids = other.update_files_by_path_checked(vec![(path, Some(text.to_string()))], || Ok::<_, ()>(())).unwrap();
+    assert_eq!(analysis.semantic_model(ids[0]).file_facts(), other.semantic_model(other_ids[0]).file_facts());
+}
+#[test]
+fn shared_ingestion_propagates_each_interruption_and_removes() {
+    let path = std::env::current_dir().unwrap().join("binding-test-input/c.lua");
+    let mut checks = 0;
+    let mut analysis = EmmyLuaAnalysis::new();
+    let ids = analysis.update_files_by_path_shared_checked(vec![(path.clone(), Some(Arc::from("return 1")))], || { checks += 1; Ok::<_, &str>(()) }).unwrap();
+    for stop in 1..=checks {
+        let mut interrupted = EmmyLuaAnalysis::new();
+        let mut count = 0;
+        assert_eq!(interrupted.update_files_by_path_shared_checked(vec![(path.clone(), Some(Arc::from("return 1")))], || { count += 1; if count == stop { Err("cancel-original") } else { Ok(()) } }), Err("cancel-original"));
+        assert_eq!(count, stop);
+    }
+    analysis.update_files_by_path_shared_checked(vec![(path, None)], || Ok::<_, ()>(())).unwrap();
+    assert!(analysis.db.get_file_text(ids[0]).is_none());
+}
+#[test]
+fn managed_unavailable_and_absent_do_not_fall_back() {
+    let (analysis, ids, _) = load();
+    let use_site = site(&analysis, ids[0], "x");
+    for (decision, expected) in [(BindingDecision::Unavailable { proof: "p".into(), reason: "blocked".into() }, LuaType::Unknown), (BindingDecision::KnownAbsent { proof: "p".into() }, LuaType::Nil)] {
+        let mut provider = context("phase");
+        provider.decisions.insert(use_site, decision);
+        let session = BindingSession::new(Arc::new(provider));
+        let model = analysis.semantic_model_with_context(ids[0], session.clone());
+        assert_eq!(model.type_of_expr(use_site.syntax), expected);
+        assert!(!session.coverage().is_empty());
+    }
+}
+#[test]
+fn model_for_inherits_context_and_context_caches_are_isolated() {
+    let (analysis, ids, _) = load();
+    let use_site = site(&analysis, ids[0], "x");
+    let origin = site(&analysis, ids[1], "true");
+    let mut provider = context("selected");
+    provider.decisions.insert(use_site, BindingDecision::Bound(BoundValue { identity: "boolean-value".into(), proof: "p".into(), value: SelectedValue::Expression(origin) }));
+    let session = BindingSession::new(Arc::new(provider));
+    let selected = analysis.semantic_model_with_context(ids[1], session.clone());
+    let foreign = selected.model_for(ids[0]);
+    assert_eq!(foreign.binding_context_identity(), Some("selected"));
+    assert_eq!(foreign.type_of_expr(use_site.syntax), LuaType::BooleanConst(true));
+    assert_eq!(analysis.semantic_model(ids[0]).type_of_expr(use_site.syntax), LuaType::IntegerConst(42));
+    let raw_session = BindingSession::new(Arc::new(context("raw")));
+    assert_eq!(analysis.semantic_model_with_context(ids[0], raw_session).type_of_expr(use_site.syntax), LuaType::IntegerConst(42));
+    assert_eq!(foreign.type_of_expr(use_site.syntax), LuaType::BooleanConst(true));
+}
+#[test]
+fn selected_expression_cycles_are_bounded_and_visible() {
+    let (analysis, ids, _) = load();
+    let use_site = site(&analysis, ids[0], "x");
+    let mut provider = context("cycle");
+    provider.decisions.insert(use_site, BindingDecision::Bound(BoundValue { identity: "cycle".into(), proof: "p".into(), value: SelectedValue::Expression(use_site) }));
+    let session = BindingSession::new(Arc::new(provider));
+    assert_eq!(analysis.semantic_model_with_context(ids[0], session.clone()).type_of_expr(use_site.syntax), LuaType::Unknown);
+    assert!(session.coverage().iter().any(|row| row.reason.as_deref() == Some("binding_projection_cycle")));
+}
+#[test]
+fn environment_records_keep_actual_slots_and_raw_evidence() {
+    let value = serde_json::json!({"kind":"function","name":"Host","parameters":[{"index":1,"name":"unit","type":"UnitToken","nilable":false,"line":4,"raw":{"Name":"unit"}}],"returns":[{"index":1,"name":"ok","type":"bool","nilable":false,"line":5}],"raw":{"documentation":"完整"}});
+    let record: EnvironmentRecord = serde_json::from_value(value.clone()).unwrap();
+    assert_eq!(record.parameters[0].type_name, "UnitToken");
+    assert_eq!(record.returns[0].type_name, "bool");
+    assert_eq!(record.raw["documentation"], "完整");
+    assert_eq!(serde_json::to_value(&record).unwrap()["parameters"][0]["raw"], value["parameters"][0]["raw"]);
+}
