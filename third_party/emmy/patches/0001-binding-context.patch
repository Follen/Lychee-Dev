+            .unwrap_or(BindingDecision::NotManaged)
+    }
+}
+fn load(source: &str) -> (EmmyLuaAnalysis, FileId) {
+    let mut analysis = EmmyLuaAnalysis::new();
+    let root = std::env::current_dir()
