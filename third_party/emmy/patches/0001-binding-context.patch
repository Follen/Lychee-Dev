+                let valid = self.binding_session.as_ref().is_some_and(|session| {
+                    session.identity() == metadata.context
+                        && session.token == metadata.session_token
+                }) && metadata.complete;
+                if let Some(session) = &self.binding_session {
+                    session.record(
+                        metadata.site,
+                        "structure_check",
+                        if valid {
+                            "native_checked"
+                        } else {
+                            "unavailable"
+                        },
+                        metadata.proof.clone(),
+                        (!valid).then(|| "object_context_or_shape_unavailable".into()),
+                    );
+                }
+                if !valid {
+                    return false;
+                }
+            }
+            ty.push_direct_children(&mut pending);
+        }
+        true
+    }
