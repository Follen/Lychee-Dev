+fn environment_slot(slot: &EnvironmentSlot, types: &EnvironmentTypeCatalog, depth: usize) -> Result<LuaType, &'static str> {
+    let mut ty = environment_type(&slot.type_name, &slot.inner_type, types, depth)?;
+    if slot.nilable { ty = LuaType::Union(Arc::new(crate::LuaUnionType::from_vec(vec![ty, LuaType::Nil]))); }
+    Ok(ty)
+}
+fn environment_type(name: &str, inner: &str, types: &EnvironmentTypeCatalog, depth: usize) -> Result<LuaType, &'static str> {
+    if depth >= 32 { return Err("environment_type_depth"); }
+    if let Some(alias) = types.aliases.get(name) { return environment_type(alias, inner, types, depth + 1); }
+    Ok(match name {
+        "number" => LuaType::Number, "integer" => LuaType::Integer,
+        "string" => LuaType::String, "bool" | "boolean" => LuaType::Boolean,
+        "nil" => LuaType::Nil, "any" => LuaType::Any,
+        "function" | "LuaFunction" => LuaType::Function,
+        "table" if inner.is_empty() => LuaType::Table,
+        _ => return Err("environment_type_unavailable"),
+    })
+}
+fn environment_function(callable: &EnvironmentCallable) -> Result<LuaFunctionType, &'static str> {
+    if callable.declaration.kind != "function" || callable.origin.identity.is_empty() || callable.origin.material_sha256.len() != 64 { return Err("environment_callable_identity_invalid"); }
+    if callable.declaration.parameters.len() > 32 || callable.declaration.returns.len() > 32 { return Err("environment_signature_budget"); }
+    let parameters = callable.declaration.parameters.iter().enumerate().map(|(i, slot)| {
+        if slot.index != i + 1 { return Err("environment_parameter_index_invalid"); }
+        Ok((slot.name.clone(), Some(environment_slot(slot, &callable.types, 0)?)))
+    }).collect::<Result<Vec<_>, _>>()?;
+    let returns = callable.declaration.returns.iter().enumerate().map(|(i, slot)| {
+        if slot.index != i + 1 { return Err("environment_return_index_invalid"); }
+        environment_slot(slot, &callable.types, 0)
+    }).collect::<Result<Vec<_>, _>>()?;
+    let returns = if callable.declaration.raw.get("MayReturnNothing") == Some(&serde_json::Value::Bool(true)) {
+        LuaType::Variadic(Arc::new(crate::VariadicType::Base(LuaType::Unknown)))
+    } else { LuaType::Tuple(Arc::new(LuaTupleType::new(returns, LuaTupleStatus::InferResolve))) };
+    Ok(LuaFunctionType::new(AsyncState::None, callable.declaration.owner.is_some(), false, parameters, returns, None))
