+impl SemanticModel<'_> {
+    pub(crate) fn binding_manages(&self, syntax: LuaSyntaxId) -> bool {
+        self.binding_session.as_ref().is_some_and(|session| !matches!(session.context.resolve(BindingSite { file_id: self.file_id(), syntax }), BindingDecision::NotManaged))
+    }
+
+    pub(crate) fn binding_call_allowed(&self, syntax: LuaSyntaxId, operation: &'static str) -> bool {
+        let Some(session) = &self.binding_session else { return true; };
+        let site = BindingSite { file_id: self.file_id(), syntax };
+        match session.context.call(site) {
+            BindingDecision::NotManaged => true,
+            BindingDecision::Bound(permit) => { session.record(site, operation, "bound", permit.proof, None); true }
+            BindingDecision::KnownAbsent { proof } => { session.record(site, operation, "known_absent", proof, None); false }
+            BindingDecision::Unavailable { proof, reason } => { session.record(site, operation, "unavailable", proof, Some(reason)); false }
+        }
+    }
+
+    pub(crate) fn binding_type_of_expr(&self, syntax: LuaSyntaxId) -> Option<LuaType> {
+        let session = self.binding_session.as_ref()?;
+        let site = BindingSite { file_id: self.file_id(), syntax };
+        if !session.enter(site) {
+            session.record(site, "resolve", "unavailable", String::new(), Some("binding_projection_cycle".into()));
+            return Some(LuaType::Unknown);
+        }
+        let result = self.binding_type_inner(site);
+        session.leave(site);
+        result
+    }
+
+    fn binding_type_inner(&self, site: BindingSite) -> Option<LuaType> {
+        let session = self.binding_session.as_ref()?;
+        let is_call = self.syntax_tree().and_then(|tree| site.syntax.to_node_from_root(&tree.get_red_root())).and_then(LuaCallExpr::cast).is_some();
+        if is_call {
+            match session.context.call(site) {
+                BindingDecision::KnownAbsent { proof } => {
+                    session.record(site, "call", "known_absent", proof, None);
+                    return Some(LuaType::Unknown);
+                }
+                BindingDecision::Unavailable { proof, reason } => {
+                    session.record(site, "call", "unavailable", proof, Some(reason));
+                    return Some(LuaType::Unknown);
+                }
+                BindingDecision::Bound(permit) => {
+                    match session.context.call_observation(site) {
+                        BindingDecision::Bound(observation) => {
+                            let valid = match session.context.resolve(permit.callee) {
+                                BindingDecision::Bound(value) if value.identity == observation.selected_callee_identity => match (&value.value, &observation.callee) {
+                                    (SelectedValue::Function(a), ObservedCallee::Source(b)) => a == b,
+                                    (SelectedValue::EnvironmentCallable(a), ObservedCallee::Environment(b)) => a.origin.identity == b.origin.identity && a.origin.material_sha256 == b.origin.material_sha256 && a.origin.pointer == b.origin.pointer,
+                                    _ => false,
+                                },
+                                _ => false,
+                            };
+                            if !valid || observation.returns.len() > 32 || observation.invocation_identity.is_empty()
+                                || matches!(&observation.callee, ObservedCallee::Source(_)) && observation.closure_identity.is_empty() {
+                                session.record(site, "call_return", "unavailable", observation.proof, Some("call_observation_identity_or_budget".into()));
+                                return Some(LuaType::Unknown);
+                            }
+                            if matches!(&observation.callee, ObservedCallee::Environment(callable) if callable.declaration.raw.get("MayReturnNothing") == Some(&serde_json::Value::Bool(true))) {
+                                session.record(site, "call_return", "unavailable", observation.proof, Some("environment_return_cardinality_unavailable".into()));
+                                return Some(LuaType::Variadic(Arc::new(crate::VariadicType::Base(LuaType::Unknown))));
+                            }
+                            let slots = observation.returns.into_iter().map(|value| self.binding_decision_type(site, value, "call_return").unwrap_or(LuaType::Unknown)).collect();
+                            session.record(site, "call", "bound", permit.proof, None);
+                            return Some(LuaType::Tuple(Arc::new(LuaTupleType::new(slots, LuaTupleStatus::InferResolve))));
+                        }
+                        BindingDecision::Unavailable { proof, reason } => {
+                            session.record(site, "call_return", "unavailable", proof, Some(reason));
+                            return Some(LuaType::Unknown);
+                        }
+                        BindingDecision::KnownAbsent { proof } => {
+                            session.record(site, "call_return", "known_absent", proof, None);
+                            return Some(LuaType::Unknown);
+                        }
+                        BindingDecision::NotManaged => {
+                            session.record(site, "call", "bound", permit.proof, None);
+                        }
+                    }
+                }
+                BindingDecision::NotManaged => {}
+            }
+        }
+        self.binding_decision_type(site, session.context.resolve(site), "resolve")
+    }
+
+    fn binding_decision_type(&self, site: BindingSite, decision: BindingDecision<BoundValue>, operation: &'static str) -> Option<LuaType> {
+        let session = self.binding_session.as_ref()?;
+        match decision {
+            BindingDecision::NotManaged => None,
+            BindingDecision::KnownAbsent { proof } => {
+                session.record(site, operation, "known_absent", proof, None);
+                Some(LuaType::Nil)
+            }
+            BindingDecision::Unavailable { proof, reason } => {
+                session.record(site, operation, "unavailable", proof, Some(reason));
+                Some(LuaType::Unknown)
+            }
+            BindingDecision::Bound(value) => {
+                let result = self.binding_value_type(site, &value.value);
+                match result {
+                    Ok(ty) => { session.record(site, operation, "bound", value.proof, None); Some(ty) }
+                    Err(reason) => { session.record(site, operation, "unavailable", value.proof, Some(reason.into())); Some(LuaType::Unknown) }
+                }
+            }
+        }
+    }
+
+    fn binding_object_type(&self, site: BindingSite, object: &ObjectRef) -> Result<LuaType, &'static str> {
+        let session = self.binding_session.as_ref().ok_or("object_session_missing")?;
+        if object.view.context != session.identity() || object.identity.is_empty() || object.epoch.is_empty() {
+            return Err("object_context_or_epoch_mismatch");
+        }
+        match &object.origin {
+            ObjectOrigin::Lua(origin) => {
+                if self.syntax_tree_of(origin.file_id).and_then(|t| origin.syntax.to_node_from_root(&t.get_red_root())).is_none() { return Err("object_source_origin_missing"); }
+            }
+            ObjectOrigin::Xml(origin) => {
+                if origin.path.is_empty() || origin.content_sha256.len() != 64 { return Err("object_external_origin_invalid"); }
+            }
+        }
+        {
+            let mut active = session.active_objects.lock().unwrap_or_else(|p| p.into_inner());
+            if active.len() >= 64 || !active.insert(object.view.clone()) { return Err("object_projection_cycle_or_depth"); }
+        }
+        let result = (|| {
+            let cached = session.shapes.lock().unwrap_or_else(|p| p.into_inner()).get(&object.view).cloned();
+            let shape = if let Some(shape) = cached { shape } else {
+                let BindingDecision::Bound(shape) = session.context.object_shape(&object.view) else { return Err("object_shape_unavailable"); };
+                if shape.key != object.view || shape.proof.is_empty() || shape.fields.len() > 128 { return Err("object_shape_identity_or_budget"); }
+                session.shapes.lock().unwrap_or_else(|p| p.into_inner()).insert(object.view.clone(), shape.clone());
+                shape
+            };
+            let mut fields = hashbrown::HashMap::new();
+            let mut seen = std::collections::HashSet::new();
+            let mut complete = matches!(shape.enumeration, ShapeEnumeration::Complete);
+            for field in &shape.fields {
+                if !seen.insert(field.key.clone()) { return Err("object_duplicate_field"); }
+                if field.presence == FieldPresence::Absent {
+                    if !matches!(field.value, BindingDecision::KnownAbsent { .. }) { complete = false; }
+                    continue;
+                }
+                let ty = if field.presence == FieldPresence::Unavailable { complete = false; LuaType::Unknown }
+                    else { self.binding_decision_type(site, field.value.clone(), "object_field").unwrap_or(LuaType::Unknown) };
+                if matches!(ty, LuaType::Unknown) { complete = false; }
+                fields.insert(crate::LuaMemberKey::Name(field.key.clone().into()), ty);
+            }
+            session.record(site, "object_shape", if complete { "bound" } else { "unavailable" }, shape.proof.clone(), (!complete).then(|| "object_shape_incomplete".into()));
+            let metadata = BoundObjectType { context: session.identity().into(), identity: object.identity.clone(), epoch: object.epoch.clone(), view: object.view.clone(), site, proof: shape.proof, complete };
+            Ok(LuaType::Object(Arc::new(crate::LuaObjectType::new_with_fields(fields, Vec::new()).with_binding(metadata))))
+        })();
+        session.active_objects.lock().unwrap_or_else(|p| p.into_inner()).remove(&object.view);
+        result
+    }
+
+    pub(crate) fn binding_members(&self, ty: &LuaType) -> Option<Vec<super::member::MemberInfo>> {
+        let LuaType::Object(object) = ty else { return None; };
+        let metadata = object.binding()?;
+        let Some(session) = &self.binding_session else { return Some(Vec::new()); };
+        if metadata.context != session.identity() { session.record(metadata.site, "member_lookup", "unavailable", metadata.proof.clone(), Some("object_context_mismatch".into())); return Some(Vec::new()); }
+        let shape = session.shapes.lock().unwrap_or_else(|p| p.into_inner()).get(&metadata.view).cloned();
+        let Some(shape) = shape else { return Some(Vec::new()); };
+        let mut members = Vec::new();
+        for field in &shape.fields {
+            let key = crate::LuaMemberKey::Name(field.key.clone().into());
+            let Some(typ) = object.get_fields().get(&key) else { continue; };
+            let (file_id, id) = match &field.destination_write {
+                FieldWriteOrigin::Xml(_) => (None, None),
+                FieldWriteOrigin::Lua(span) => {
+                    let found = self.file_facts_of(span.file_id).and_then(|facts| facts.members.iter().find(|member| member.key == key && member.id.member_key_range().is_some_and(|range| span.range.contains_range(range)))).map(|member| member.id.clone());
+                    (Some(span.file_id), found)
+                }
+            };
+            members.push(super::member::MemberInfo { key, typ: typ.clone(), id, file_id, is_method: matches!(typ, LuaType::DocFunction(f) if f.is_colon_define()) });
+        }
+        session.record(metadata.site, "member_lookup", if metadata.complete { "bound" } else { "unavailable" }, metadata.proof.clone(), (!metadata.complete).then(|| "object_shape_incomplete".into()));
+        Some(members)
+    }
