+            let cached = session
+                .shapes
+                .lock()
+                .unwrap_or_else(|p| p.into_inner())
+                .get(&object.view)
+                .cloned();
+            let shape = if let Some((frozen, shape)) = cached {
+                if &frozen != object {
+                    return Err("object_frozen_identity_mismatch");
+                }
+                shape
+            } else {
+                let BindingDecision::Bound(shape) = session.context.object_shape(&object.view)
+                else {
+                    return Err("object_shape_unavailable");
+                };
+                if shape.key != object.view || shape.proof.is_empty() || shape.fields.len() > 128 {
+                    return Err("object_shape_identity_or_budget");
+                }
+                let mut shapes = session.shapes.lock().unwrap_or_else(|p| p.into_inner());
