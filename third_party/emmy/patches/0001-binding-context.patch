+    pub(crate) fn binding_structure_allowed(&self, ty: &LuaType) -> bool {
+        use crate::LuaTypeNode;
+        let mut pending = vec![ty];
+        let mut steps = 0;
+        while let Some(ty) = pending.pop() {
+            steps += 1;
+            if steps > 4096 { return false; }
+            if let LuaType::Object(object) = ty && let Some(metadata) = object.binding() {
+                let valid = self.binding_session.as_ref().is_some_and(|session| session.identity() == metadata.context) && metadata.complete;
+                if let Some(session) = &self.binding_session {
+                    session.record(metadata.site, "structure_check", if valid { "native_checked" } else { "unavailable" }, metadata.proof.clone(), (!valid).then(|| "object_context_or_shape_unavailable".into()));
+                }
+                if !valid { return false; }
+            }
+            ty.push_direct_children(&mut pending);
+        }
+        true
+    }
