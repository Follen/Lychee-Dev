+#[derive(Clone, Debug)]
+pub struct CallPermit {
+    pub callee: BindingSite,
+    pub proof: String,
+    pub capability_profile: String,
+}
+#[derive(Clone, Debug)]
+pub enum ObservedCallee {
+    Source(FunctionRef),
+    Environment(Arc<EnvironmentCallable>),
