+    /// Parsing/cache rebuild remain synchronous: a host must enforce its hard
+    /// deadline with an owned worker process in addition to this callback.
+    pub fn update_files_by_path_shared_checked<E>(
+        &mut self,
+        files: Vec<(PathBuf, Option<Arc<str>>)>,
+        mut check: impl FnMut() -> Result<(), E>,
+    ) -> Result<Vec<FileId>, E> {
+        check()?;
+        let mut mapped = Vec::with_capacity(files.len());
+        for (path, text) in files {
+            check()?;
+            if let Some(uri) = file_path_to_uri(&path) { mapped.push((uri, text)); }
+        }
+        self.db.set_files_shared_checked(mapped, check)
+    }
