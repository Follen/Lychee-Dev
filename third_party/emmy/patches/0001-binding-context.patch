+                        .file_facts_of(span.file_id)
+                        .and_then(|facts| {
+                            facts.members.iter().find(|member| {
+                                member.key == key
+                                    && member
+                                        .id
+                                        .member_key_range()
+                                        .is_some_and(|range| span.range.contains_range(range))
+                            })
+                        })
+                        .map(|member| member.id.clone());
+                    (Some(span.file_id), found)
+                }
+            };
+            members.push(super::member::MemberInfo {
+                key,
+                typ: typ.clone(),
+                id,
+                file_id,
+                is_method: matches!(typ, LuaType::DocFunction(f) if f.is_colon_define()),
