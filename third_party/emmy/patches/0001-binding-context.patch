+            session.record(
+                metadata.site,
+                "member_lookup",
+                "unavailable",
+                metadata.proof.clone(),
+                Some("object_context_mismatch".into()),
+            );
+            return Some(Vec::new());
+        }
+        let shape = session
+            .shapes
+            .lock()
+            .unwrap_or_else(|p| p.into_inner())
+            .get(&metadata.view)
+            .cloned();
+        let Some((frozen, shape)) = shape else {
+            return Some(Vec::new());
+        };
+        if frozen.identity != metadata.identity || frozen.epoch != metadata.epoch {
+            session.record(
+                metadata.site,
+                "member_lookup",
+                "unavailable",
+                metadata.proof.clone(),
+                Some("object_frozen_identity_mismatch".into()),
+            );
+            return Some(Vec::new());
+        }
