+            .syntax_tree()
+            .and_then(|tree| syntax.to_node_from_root(&tree.get_red_root()))
+            .is_none()
+        {
+            return BindingDecision::Unavailable {
+                proof: String::new(),
+                reason: "binding_syntax_missing".into(),
+            };
+        }
+        session.context.resolve(BindingSite {
+            file_id: self.file_id(),
+            syntax,
+        })
