+pub struct EnvironmentTypeCatalog {
+    pub identity: String, pub aliases: BTreeMap<String, String>,
+    pub nominal_objects: BTreeMap<String, serde_json::Value>,
+    pub declarations: BTreeMap<String, Vec<EnvironmentRecord>>,
+}
+#[derive(Clone, Debug)]
+pub struct EnvironmentOrigin { pub material: String, pub material_sha256: String, pub pointer: String, pub identity: String }
+#[derive(Clone, Debug)]
+pub struct EnvironmentCallable { pub origin: EnvironmentOrigin, pub declaration: EnvironmentRecord, pub types: Arc<EnvironmentTypeCatalog> }
+impl EnvironmentCallable {
+    pub fn nominal_return_name(&self, slot: usize) -> Option<&str> {
+        let value = self.declaration.returns.get(slot.checked_sub(1)?)?;
+        if value.index != slot || value.nilable { return None; }
+        self.types.nominal_objects.contains_key(&value.type_name).then_some(value.type_name.as_str())
+    }
+    pub fn receiver_type_name(&self) -> Option<&str> {
+        let owner = self.declaration.owner.as_ref().filter(|o| o.kind == "script-object")?;
+        let mut names = self.types.nominal_objects.iter().filter(|(_, value)| value.get("owner").and_then(serde_json::Value::as_str) == Some(owner.name.as_str()));
+        let (name, _) = names.next()?;
+        if names.next().is_some() { return None; }
+        Some(name.as_str())
+    }
+}
+#[derive(Clone, Debug)]
+pub struct EnvironmentReturn { pub callable: Arc<EnvironmentCallable>, pub slot: usize, pub invocation_identity: String }
+
+pub trait BindingContext: Send + Sync {
+    fn identity(&self) -> &str;
+    fn resolve(&self, site: BindingSite) -> BindingDecision<BoundValue>;
+    fn call(&self, _site: BindingSite) -> BindingDecision<CallPermit> { BindingDecision::NotManaged }
+    fn call_observation(&self, _site: BindingSite) -> BindingDecision<CallObservation> { BindingDecision::NotManaged }
+    fn object_shape(&self, _key: &ObjectViewKey) -> BindingDecision<ObjectShape> { BindingDecision::Unavailable { proof: String::new(), reason: "object_shape_provider_unavailable".into() } }
+    fn references(&self, _identity: &str) -> BindingDecision<Vec<BindingReference>> { BindingDecision::Unavailable { proof: String::new(), reason: "reference_provider_unavailable".into() } }
+}
+#[derive(Clone, Debug)]
+pub struct BindingCoverage {
+    pub site: BindingSite, pub operation: &'static str, pub state: &'static str,
+    pub proof: String, pub reason: Option<String>, pub parameter: Option<String>,
+    pub parameter_index: Option<usize>, pub argument: Option<BindingSite>,
+}
+/// All context-dependent state is session-owned, never stored in the database.
+/// Models made with `model_for` retain this exact Arc, including cycle guards.
+#[derive(Clone, Debug, PartialEq, Eq, Hash)]
+pub struct BoundObjectType {
+    pub context: String, pub identity: String, pub epoch: String,
+    pub view: ObjectViewKey, pub site: BindingSite, pub proof: String, pub complete: bool,
+}
+
+pub struct BindingSession {
+    pub(crate) context: Arc<dyn BindingContext>,
+    identity: String,
+    coverage: Mutex<Vec<BindingCoverage>>,
+    active: Mutex<HashSet<BindingSite>>,
+    pub(crate) active_objects: Mutex<HashSet<ObjectViewKey>>,
+    pub(crate) shapes: Mutex<HashMap<ObjectViewKey, ObjectShape>>,
+}
+impl BindingSession {
+    pub fn new(context: Arc<dyn BindingContext>) -> Arc<Self> {
+        Arc::new(Self { identity: context.identity().into(), context, coverage: Mutex::new(Vec::new()), active: Mutex::new(HashSet::new()), active_objects: Mutex::new(HashSet::new()), shapes: Mutex::new(HashMap::new()) })
+    }
+    pub fn identity(&self) -> &str { &self.identity }
+    pub fn coverage(&self) -> Vec<BindingCoverage> { self.coverage.lock().unwrap_or_else(|p| p.into_inner()).clone() }
+    pub fn references(&self, identity: &str) -> BindingDecision<Vec<BindingReference>> { self.context.references(identity) }
+    pub(crate) fn record(&self, site: BindingSite, operation: &'static str, state: &'static str, proof: String, reason: Option<String>) {
+        let mut rows = self.coverage.lock().unwrap_or_else(|p| p.into_inner());
+        if !rows.iter().any(|r| r.site == site && r.operation == operation && r.state == state && r.proof == proof && r.reason == reason) {
+            rows.push(BindingCoverage { site, operation, state, proof, reason, parameter: None, parameter_index: None, argument: None });
+        }
+    }
+    pub(crate) fn enter(&self, site: BindingSite) -> bool {
+        let mut active = self.active.lock().unwrap_or_else(|p| p.into_inner());
+        active.len() < 64 && active.insert(site)
+    }
+    pub(crate) fn leave(&self, site: BindingSite) { self.active.lock().unwrap_or_else(|p| p.into_inner()).remove(&site); }
+}
