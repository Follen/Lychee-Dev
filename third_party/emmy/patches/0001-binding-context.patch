+/// Only the final expression of an expanding Lua list retains its result pack.
+/// The public upstream VM forwards parenthesized values unchanged, so managed
+/// evidence must apply this adjustment before either VM or public-query use.
+fn binding_call_expands(call: &LuaCallExpr) -> bool {
+    let Some(parent) = call.syntax().parent() else {
+        return false;
+    };
+    let is_call = |expr: &LuaExpr| expr.get_syntax_id() == call.get_syntax_id();
+    if let Some(args) = LuaCallArgList::cast(parent.clone()) {
+        return args.get_args().last().as_ref().is_some_and(is_call);
+    }
+    if let Some(stat) = LuaReturnStat::cast(parent.clone()) {
+        return stat.get_expr_list().last().as_ref().is_some_and(is_call);
+    }
+    if let Some(stat) = LuaLocalStat::cast(parent.clone()) {
+        let values = stat.get_value_exprs().collect::<Vec<_>>();
+        return stat.get_local_name_list().count() > values.len()
+            && values.last().is_some_and(is_call);
+    }
+    if let Some(stat) = LuaAssignStat::cast(parent.clone()) {
+        let (vars, values) = stat.get_var_and_expr_list();
+        return vars.len() > values.len() && values.last().is_some_and(is_call);
+    }
+    if let Some(stat) = LuaForRangeStat::cast(parent.clone()) {
+        return stat.get_expr_list().last().as_ref().is_some_and(is_call);
+    }
+    if let Some(field) = LuaTableField::cast(parent) {
+        return field.is_value_field()
+            && field
+                .get_parent::<LuaTableExpr>()
+                .and_then(|table| table.get_fields().last())
+                .is_some_and(|last| last.get_syntax_id() == field.get_syntax_id());
+    }
+    false
+}
+
+fn environment_slot(
+    slot: &EnvironmentSlot,
+    types: &EnvironmentTypeCatalog,
+    depth: usize,
+) -> Result<LuaType, &'static str> {
+    let mut ty = environment_type(&slot.type_name, &slot.inner_type, types, depth)?;
+    if slot.nilable {
+        ty = LuaType::Union(Arc::new(crate::LuaUnionType::from_vec(vec![
+            ty,
+            LuaType::Nil,
+        ])));
+    }
+    Ok(ty)
+}
+fn environment_type(
+    name: &str,
+    inner: &str,
+    types: &EnvironmentTypeCatalog,
+    depth: usize,
+) -> Result<LuaType, &'static str> {
+    if depth >= 32 {
+        return Err("environment_type_depth");
+    }
+    if let Some(alias) = types.aliases.get(name) {
+        return environment_type(alias, inner, types, depth + 1);
+    }
+    Ok(match name {
+        "number" => LuaType::Number,
+        "integer" => LuaType::Integer,
+        "string" => LuaType::String,
+        "bool" | "boolean" => LuaType::Boolean,
+        "nil" => LuaType::Nil,
+        "any" => LuaType::Any,
+        "function" | "LuaFunction" => LuaType::Function,
+        "table" if inner.is_empty() => LuaType::Table,
+        _ => return Err("environment_type_unavailable"),
+    })
+}
+fn environment_function(callable: &EnvironmentCallable) -> Result<LuaFunctionType, &'static str> {
+    if callable.declaration.kind != "function"
+        || callable.origin.identity.is_empty()
+        || callable.origin.material_sha256.len() != 64
+    {
+        return Err("environment_callable_identity_invalid");
+    }
+    if callable.declaration.owner.is_some() {
+        return Err("environment_receiver_unavailable");
+    }
+    if callable.declaration.parameters.len() > 32 || callable.declaration.returns.len() > 32 {
+        return Err("environment_signature_budget");
+    }
+    let parameters = callable
+        .declaration
+        .parameters
+        .iter()
+        .enumerate()
+        .map(|(i, slot)| {
+            if slot.index != i + 1 {
+                return Err("environment_parameter_index_invalid");
+            }
+            Ok((
+                slot.name.clone(),
+                Some(environment_slot(slot, &callable.types, 0)?),
+            ))
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let returns = callable
+        .declaration
+        .returns
+        .iter()
+        .enumerate()
+        .map(|(i, slot)| {
+            if slot.index != i + 1 {
+                return Err("environment_return_index_invalid");
+            }
+            environment_slot(slot, &callable.types, 0)
+        })
+        .collect::<Result<Vec<_>, _>>()?;
+    let returns = if callable.declaration.raw.get("MayReturnNothing")
+        == Some(&serde_json::Value::Bool(true))
+    {
+        LuaType::Variadic(Arc::new(crate::VariadicType::Base(LuaType::Unknown)))
+    } else {
+        LuaType::Variadic(Arc::new(crate::VariadicType::Multi(returns)))
+    };
+    Ok(LuaFunctionType::new(
+        AsyncState::None,
+        false,
+        false,
+        parameters,
+        returns,
+        None,
+    ))
+}
+
+fn binding_type_has_unknown(ty: &LuaType) -> bool {
+    use crate::LuaTypeNode;
+    let mut stack = vec![ty];
+    let mut count = 0;
+    while let Some(ty) = stack.pop() {
+        count += 1;
+        if count > 4096 || matches!(ty, LuaType::Unknown | LuaType::Any) {
+            return true;
+        }
+        ty.push_direct_children(&mut stack);
+    }
+    false
+}
