+#[test]
+fn public_expression_lists_do_not_expand_nonlast_managed_calls() {
+    for (statement, expected) in [
+        (
+            "return F(), 7",
+            vec![LuaType::BooleanConst(true), LuaType::IntegerConst(7)],
