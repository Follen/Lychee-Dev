+        session.record(
+            metadata.site,
+            "member_lookup",
+            if metadata.complete {
+                "bound"
+            } else {
+                "unavailable"
+            },
+            metadata.proof.clone(),
+            (!metadata.complete).then(|| "object_shape_incomplete".into()),
+        );
+        Some(members)
+    }
