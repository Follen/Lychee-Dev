+                    .syntax_tree_of(origin.file_id)
+                    .and_then(|t| origin.syntax.to_node_from_root(&t.get_red_root()))
+                    .is_none()
+                {
+                    return Err("object_source_origin_missing");
+                }
+            }
+            ObjectOrigin::Xml(origin) => {
+                if origin.path.is_empty() || origin.content_sha256.len() != 64 {
+                    return Err("object_external_origin_invalid");
+                }
+            }
